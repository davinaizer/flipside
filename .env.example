DATABASE_URL=postgres://flipside:flipside@127.0.0.1:5432/flipside
IMAGE_STORE_DRIVER=fs
IMAGE_STORE_PATH=./data/images
PORT=3000
# Development account that `pnpm db:seed` creates and gives the seeded profiles. Local use only;
# on the hosted app create the real account with `pnpm account:create` (docs/operations.md).
DEV_ACCOUNT_EMAIL=dev@flipside.local
DEV_ACCOUNT_PASSWORD=change-me-please

# Hosted (Vercel) or CLI only; leave unset on the Mac Mini.
# Direct Neon connection: used by migrations and import:cli instead of the pooled DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Private Vercel Blob token, read by the SDK when IMAGE_STORE_DRIVER=vercel-blob.
# BLOB_READ_WRITE_TOKEN=
