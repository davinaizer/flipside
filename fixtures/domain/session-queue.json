{
  "description": "Session queue cases (PRD section 5 Re-queue within a session and Undo, R5, R6, R8). Each case starts a queue from cardIds and applies steps in order. A step is a grade (not_yet, nearly, got_it) or undo. expect describes the state after that step: queue lists card ids per entry, attempts the attempt number per entry (1 first, 2 and 3 re-queued), position the current index (queue length when finished), current the current card id or null, counts the progress bar segments, requeues per card. Gap 4 and cap 2 (REQUEUE_GAP, REQUEUE_MAX_PER_SESSION). Not yet inserts the new entry so four other entries come before it, or appends when four or fewer remain after the graded card. Undo at the session start changes nothing.",
  "gap": 4,
  "maxRequeues": 2,
  "cases": [
    {
      "name": "start state",
      "cardIds": ["a", "b", "c"],
      "steps": [],
      "start": {
        "queue": ["a", "b", "c"],
        "attempts": [1, 1, 1],
        "position": 0,
        "current": "a",
        "counts": { "done": 0, "current": 1, "remaining": 2 },
        "requeues": {},
        "canUndo": false
      }
    },
    {
      "name": "Not yet reappears after four other cards",
      "cardIds": ["a", "b", "c", "d", "e", "f", "g"],
      "steps": [
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 1,
            "current": "b",
            "counts": { "done": 1, "current": 1, "remaining": 6 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 2,
            "current": "c",
            "counts": { "done": 2, "current": 1, "remaining": 5 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "nearly",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 3,
            "current": "d",
            "counts": { "done": 3, "current": 1, "remaining": 4 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 4,
            "current": "e",
            "counts": { "done": 4, "current": 1, "remaining": 3 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 5,
            "current": "a",
            "counts": { "done": 5, "current": 1, "remaining": 2 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "f", "g"],
            "attempts": [1, 1, 1, 1, 1, 2, 1, 1],
            "position": 6,
            "current": "f",
            "counts": { "done": 6, "current": 1, "remaining": 1 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        }
      ]
    },
    {
      "name": "Not yet with exactly four remaining goes to the end",
      "cardIds": ["a", "b", "c", "d", "e"],
      "steps": [
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a"],
            "attempts": [1, 1, 1, 1, 1, 2],
            "position": 1,
            "current": "b",
            "counts": { "done": 1, "current": 1, "remaining": 4 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        }
      ]
    },
    {
      "name": "Not yet with fewer than four remaining goes to the end",
      "cardIds": ["a", "b", "c"],
      "steps": [
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "a"],
            "attempts": [1, 1, 1, 2],
            "position": 1,
            "current": "b",
            "counts": { "done": 1, "current": 1, "remaining": 2 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "a"],
            "attempts": [1, 1, 1, 2],
            "position": 2,
            "current": "c",
            "counts": { "done": 2, "current": 1, "remaining": 1 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "a", "c"],
            "attempts": [1, 1, 1, 2, 2],
            "position": 3,
            "current": "a",
            "counts": { "done": 3, "current": 1, "remaining": 1 },
            "requeues": { "a": 1, "c": 1 },
            "canUndo": true
          }
        }
      ]
    },
    {
      "name": "Not yet on the last card re-queues it right after",
      "cardIds": ["a", "b"],
      "steps": [
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b"],
            "attempts": [1, 1],
            "position": 1,
            "current": "b",
            "counts": { "done": 1, "current": 1, "remaining": 0 },
            "requeues": {},
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "b"],
            "attempts": [1, 1, 2],
            "position": 2,
            "current": "b",
            "counts": { "done": 2, "current": 1, "remaining": 0 },
            "requeues": { "b": 1 },
            "canUndo": true
          }
        }
      ]
    },
    {
      "name": "A card is re-queued at most twice",
      "cardIds": ["a"],
      "steps": [
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "a"],
            "attempts": [1, 2],
            "position": 1,
            "current": "a",
            "counts": { "done": 1, "current": 1, "remaining": 0 },
            "requeues": { "a": 1 },
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "a", "a"],
            "attempts": [1, 2, 3],
            "position": 2,
            "current": "a",
            "counts": { "done": 2, "current": 1, "remaining": 0 },
            "requeues": { "a": 2 },
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "a", "a"],
            "attempts": [1, 2, 3],
            "position": 3,
            "current": null,
            "counts": { "done": 3, "current": 0, "remaining": 0 },
            "requeues": { "a": 2 },
            "canUndo": true
          }
        },
        {
          "action": "undo",
          "expect": {
            "queue": ["a", "a", "a"],
            "attempts": [1, 2, 3],
            "position": 2,
            "current": "a",
            "counts": { "done": 2, "current": 1, "remaining": 0 },
            "requeues": { "a": 2 },
            "canUndo": true
          }
        }
      ]
    },
    {
      "name": "Re-queue cap is per card in a longer session",
      "cardIds": ["a", "b", "c", "d", "e", "f"],
      "steps": [
        {
          "action": "not_yet",
