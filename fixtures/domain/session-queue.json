            "position": 3,
            "current": "d",
            "counts": { "done": 3, "current": 1, "remaining": 4 },
            "requeues": { "a": 1, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1],
            "position": 4,
            "current": "e",
            "counts": { "done": 4, "current": 1, "remaining": 3 },
            "requeues": { "a": 1, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1],
            "position": 5,
            "current": "a",
            "counts": { "done": 5, "current": 1, "remaining": 2 },
            "requeues": { "a": 1, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f", "a"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1, 3],
            "position": 6,
            "current": "b",
            "counts": { "done": 6, "current": 1, "remaining": 2 },
            "requeues": { "a": 2, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f", "a"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1, 3],
            "position": 7,
            "current": "f",
            "counts": { "done": 7, "current": 1, "remaining": 1 },
            "requeues": { "a": 2, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "got_it",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f", "a"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1, 3],
            "position": 8,
            "current": "a",
            "counts": { "done": 8, "current": 1, "remaining": 0 },
            "requeues": { "a": 2, "b": 1 },
            "canUndo": true
          }
        },
        {
          "action": "not_yet",
          "expect": {
            "queue": ["a", "b", "c", "d", "e", "a", "b", "f", "a"],
            "attempts": [1, 1, 1, 1, 1, 2, 2, 1, 3],
            "position": 9,
            "current": null,
            "counts": { "done": 9, "current": 0, "remaining": 0 },
            "requeues": { "a": 2, "b": 1 },
            "canUndo": true
          }
